# 所有路径均从工作区根目录派生。首次运行前执行 npm run workspace:init。
WORKBENCH_ROOT=./.workbench
WORKBENCH_ID=00000000-0000-4000-8000-000000000001
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:5432/workbench
# 生产容器推荐只在 DATABASE_URL 中写主机和用户名，并从 Docker secret 注入密码。
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
APP_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
COOKIE_SECURE=false
LOG_LEVEL=info
