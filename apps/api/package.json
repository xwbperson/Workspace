{
  "name": "@workspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/entrypoints/http.js",
  "scripts": {
    "dev": "tsx watch src/entrypoints/http.ts",
    "dev:test": "cross-env NODE_ENV=test DATABASE_IN_MEMORY=true tsx watch src/entrypoints/http.ts",
    "start": "node dist/entrypoints/http.js",
    "cli": "tsx src/entrypoints/cli.ts",
    "openapi:generate": "tsx src/entrypoints/generate-openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.1",
    "@inquirer/prompts": "^7.10.1",
    "@workspace/client-sdk": "0.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "pg-mem": "^3.0.5"
  }
}
